#!/bin/bash

git add .
if [ $? -eq 1 ]; then
	echo "gagal menambahkan"
else
	echo "semua sudah di add"
	echo "Masukkan pesan:"
	read commitmsg
	git commit -m "${commitmsg}"
	echo "Are you sure? (y/n)"
	read confirm

	if [ ${confirm} == 'y' ]; then
		git push
		echo "sudah dipush :)"
		sleep 5
		clear
	elif [ ${confirm} == 'n' ]; then
		echo "Tidak jadi"
	else
		echo "masukin opsi yang betul bro"
	fi
fi
